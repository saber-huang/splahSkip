<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 子页面用的主题：带蓝色标题栏（有返回箭头）。深色模式在 values-night/themes.xml 里 -->
    <style name="Theme.SplashSkip" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/accent_control</item>
        <item name="android:colorControlActivated">@color/accent_control</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- 首页用的主题：不要系统标题栏，顶部由页面里的渐变大卡片代替，状态栏颜色和它的起始色一致 -->
    <style name="Theme.SplashSkip.Main">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/brand</item>
    </style>

    <!-- ===== 常用样式：布局里用 style="@style/…" 引用，想统一改外观只改这里 ===== -->

    <!-- 白色圆角卡片 -->
    <style name="Widget.SplashSkip.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">2dp</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <!-- 卡片里一行可以点的设置项 -->
    <style name="Widget.SplashSkip.Row" parent="">
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 实心主按钮 -->
    <style name="Widget.SplashSkip.Button.Primary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 描边次按钮 -->
    <style name="Widget.SplashSkip.Button.Secondary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 输入框 -->
    <style name="Widget.SplashSkip.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
